#Emerald cost of the order terminal from a wandering trader.
# Default: 24
# Range: 1 ~ 64
terminalPrice = 24
#Maximum purchases of the terminal offer per wandering trader.
# Default: 1
# Range: 1 ~ 16
terminalMaxUses = 1
#Random offers shown per unlocked tier. The prototype supports up to 20.
# Default: 20
# Range: 1 ~ 20
offersPerTier = 20
#Minecraft days before a player's deterministic catalog changes.
# Default: 6
# Range: 1 ~ 365
catalogRefreshDays = 7
#Minecraft days before used offers restock.
# Default: 3
# Range: 1 ~ 365
restockDays = 3
#Safety cap for one shift-click batch purchase.
# Default: 64
# Range: 1 ~ 256
maximumShiftClickTrades = 64
#Delay before a purchase sack appears beside the terminal.
# Default: 200
# Range: 1 ~ 72000
purchaseDeliveryDelayTicks = 200
#Delay before a payment sack appears beside the trade crate.
# Default: 200
# Range: 1 ~ 72000
saleDeliveryDelayTicks = 200
#Personal cooldown in Minecraft days between trade-crate sales.
# Default: 3
# Range: 1 ~ 365
saleCooldownDays = 3
