#Emerald cost of the order terminal from a wandering trader.
# Default: 48
# Range: 1 ~ 64
terminalPrice = 24
#Maximum purchases of the terminal offer per wandering trader.
# Default: 1
# Range: 1 ~ 16
terminalMaxUses = 1
#Random offers shown per unlocked tier. The prototype supports up to 20.
# Default: 20
# Range: 1 ~ 20
offersPerTier = 20
#Minecraft days before a player's deterministic catalog changes.
# Default: 6
# Range: 1 ~ 365
catalogRefreshDays = 6
#Minecraft days before used offers restock.
# Default: 3
# Range: 1 ~ 365
restockDays = 3
#Safety cap for one shift-click batch purchase.
# Default: 64
# Range: 1 ~ 256
maximumShiftClickTrades = 64
#Delay before a purchase sack appears beside the terminal.
# Default: 200
# Range: 1 ~ 72000
purchaseDeliveryDelayTicks = 200
#Delay before a payment sack appears beside the trade crate.
# Default: 200
# Range: 1 ~ 72000
saleDeliveryDelayTicks = 200
#Personal cooldown in Minecraft days between trade-crate sales.
# Default: 3
# Range: 1 ~ 365
saleCooldownDays = 3

[worldgen]
	#Whether the order board can generate as part of supported villages.
	spawnInVillages = true
	#Chance, in percent, that a supported village attempts to generate one order board.
	#The jigsaw system can still reject the piece when terrain or available space does not fit.
	# Default: 50.0
	# Range: 0.0 ~ 100.0
	villageSpawnChancePercent = 50.0

	[worldgen.integrations]
		#Enable optional Towns and Towers village integration when that mod is installed.
		townsAndTowers = true
		#Enable optional Repurposed Structures village integration when that mod is installed.
		repurposedStructures = true
