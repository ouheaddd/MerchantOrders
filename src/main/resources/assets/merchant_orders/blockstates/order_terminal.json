{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "half": "lower",
        "right": "false"
      },
      "apply": {
        "model": "merchant_orders:block/order_terminal"
      }
    },
    {
      "when": {
        "facing": "south",
        "half": "lower",
        "right": "false"
      },
      "apply": {
        "model": "merchant_orders:block/order_terminal",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "half": "lower",
        "right": "false"
      },
      "apply": {
        "model": "merchant_orders:block/order_terminal",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "half": "lower",
        "right": "false"
      },
      "apply": {
        "model": "merchant_orders:block/order_terminal",
        "y": 90
      }
    }
  ]
}
